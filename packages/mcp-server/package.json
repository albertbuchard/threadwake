{
  "name": "@threadwake/mcp-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Fixture-first Model Context Protocol server for the Threadwake workgraph contract.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.22.0"
  },
  "bin": {
    "threadwake-mcp": "./dist/threadwake-mcp.mjs"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "files": [
    "dist/threadwake-mcp.mjs",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node dist/threadwake-mcp.mjs --transport stdio",
    "start:http": "node dist/threadwake-mcp.mjs --transport http",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@threadwake/contracts": "0.1.0",
    "zod": "4.4.3"
  }
}
