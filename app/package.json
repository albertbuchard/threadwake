{
  "name": "@threadwake/app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "build": "npm run typecheck && vite build && npm run verify:build",
    "build:qa": "npm run typecheck && vite build --mode qa --outDir dist/qa && npm run verify:qa",
    "dev": "vite",
    "preview": "vite preview",
    "test": "vitest run --maxWorkers=4",
    "typecheck": "tsc --noEmit",
    "verify:build": "node scripts/verify-build.mjs production",
    "verify:qa": "node scripts/verify-build.mjs qa"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@phosphor-icons/react": "2.1.10",
    "motion": "12.43.0",
    "pixi.js": "8.19.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "5.2.0",
    "jsdom": "29.0.1",
    "typescript": "7.0.2",
    "vite": "7.3.6",
    "vitest": "4.1.10"
  }
}
